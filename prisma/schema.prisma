generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  phone         String?         @unique
  phoneVerified Boolean         @default(false)
  passwordHash  String?
  role          UserRole        @default(USER)
  status        UserStatus      @default(ACTIVE)
  invitations   Invitation[]
  activities    ActivityEvent[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  feature   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model Invitation {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  occasion    String   @default("Other")
  hostName    String
  eventDate   DateTime?
  venue       String   @default("")
  message     String   @default("") @db.Text
  theme       String   @default("classic")
  published   Boolean  @default(false)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([published, slug])
}

model Template {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  occasion    String
  subtitle    String   @default("")
  theme       String   @default("wine")
  sampleHost  String
  sampleEvent String
  sampleDate  String   @default("")
  sampleVenue String   @default("")
  accent      String   @default("#D6B574")
  tag         String   @default("Luxury")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([occasion, active])
}
