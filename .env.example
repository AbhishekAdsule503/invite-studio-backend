# Local PostgreSQL example. Replace username/password/database for your machine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invite_studio?schema=public"
# Use a random secret of at least 32 characters. Example: openssl rand -base64 32
SESSION_SECRET="replace-this-with-a-random-secret-at-least-32-characters"
# Used to create public invitation links; local default is fine for development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Twilio Verify (required for real SMS OTP; create a Verify Service in Twilio Console)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Exclusive single Super Admin email address allowed to access /admin
SUPER_ADMIN_EMAIL="admin@example.com"
