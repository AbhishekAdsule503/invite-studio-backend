# Database connection strings (e.g. Supabase, Neon, or local PostgreSQL)
# DATABASE_URL: Transaction pooler connection string (used by Prisma Client in the application)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
# DIRECT_URL: Direct session connection string (used by Prisma CLI for migrations and schema pushes)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public"
# Use a random secret of at least 32 characters. Example: openssl rand -base64 32
SESSION_SECRET="replace-this-with-a-random-secret-at-least-32-characters"
# Used to create public invitation links; local default is fine for development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Supabase Client & Demo (/todos) configuration (if using client-side Supabase features alongside PostgreSQL)
# NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..." # Or NEXT_PUBLIC_SUPABASE_ANON_KEY

# Twilio Verify (required for real SMS OTP; create a Verify Service in Twilio Console)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Exclusive single Super Admin email address allowed to access /admin
SUPER_ADMIN_EMAIL="admin@example.com"
